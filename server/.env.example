# ESP32 Power Meter API server configuration.
# Copy this file to ".env" and edit the values. Every setting is optional --
# the server runs with sensible defaults if a variable is missing.

# Shared secret for POST /api/ingest. When set, the ESP32 must send the
# same value in its X-API-Key header or the server answers 401.
# Leave unset/empty to accept readings from anyone (fine on a trusted LAN,
# NOT fine if the API is exposed to the internet).
API_KEY=change-me-to-something-long-and-random

# Comma-separated list of browser origins allowed to call the API
# (CORS). "*" allows all origins, which is the default and works with a
# GitHub-Pages dashboard. To lock it down, use your Pages URL, e.g.:
# CORS_ORIGINS=https://yourname.github.io
CORS_ORIGINS=*

# Readings older than this many days are deleted by an hourly cleanup
# task. Set to 0 to keep everything forever (the SQLite file will grow
# by roughly 4-5 MB per device per month at one reading every 2 s).
RETENTION_DAYS=90
